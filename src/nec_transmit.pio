; Transmits an enocded 32 bit frame

.program nec_transmit

.define BURST_IRQ 4 ; Indicates that one of the state machine's TXN is full
.define NUM_INITIAL_BURST 16

.wrap_target ; Start of state machine
    pull

    set X, (NUM_INITIAL_BURST - 1) ; Start of NEC send. Time is 9ms

long_burst:
    irq BURST_IRQ
    jmp X-- long_burst

    nop [15] ; In nec protocal after a 9ms leading pulse a 4.5ms gap is used
    irq BURST_IRQ [1] ; Send a gap of 562.5us

send_data:
    out X, 1 ; Shift one bit MSB first. Subject to chage
    jmp !X burst ; If x is zero short low state
    nop [3] ; Not 0 must be 1 thus send a longer low state

burst:
    irq BURST_IRQ

jmp !OSRE send_data ; Keep sending until output shift register is empty


.wrap ; Recieve another packet

% c-sdk{
    static inline void nec_transmit_program_init(PIO pio, uint sm, uint offset, float tick_rate, int bits_per_frame){

        pio_sm_config = nec_transmit_program_get_default_config(offset);
        sm_config_set_out_shift(&c, false, false, bits_per_frame);
        sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
        float clkdiv = clock_get_hz (clk_sys)  / tick_rate;
        sm_config_set_clkdiv(&c, clkdiv);
        pio_sm_init(pio, sm, offset, &c);

        pio_sm_set_enabled(pio, sm, true);
    }
%}